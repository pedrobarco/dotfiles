#!/bin/zsh

_has() {
    which $1>/dev/null 2>&1
}

clone() {
    local url="$1"
    shift 1
    local repo=$(echo "$url" | grep -q "^https://" && echo ${url#*.com/} || echo ${url##*:})
    local repo="${${repo:l}%%.git*}"
    git clone $url "$@" $REPOS/$repo
}

mkrepo() {
    local repo=$(echo $1 | sed "s/\.git//g")
    local repo_path="$REPOS/$repo"

    [ -d $repo_path ] && echo "Repo already exists" && return

    mkdir -p $repo_path
    cd $repo_path > /dev/null
    git init
    cd - > /dev/null
}

rmrepo() {
    local repo=$(echo $1 | sed "s/\.git//g")
    local repo_path="$REPOS/$repo"
    rm -rf $repo_path
}

open_pr() {
    local repo=$(git config --get remote.origin.url | cut -d "@" -f2 | sed "s/.git//g" | sed "s/:/\//g")
    local branch=$(git branch --show-current)

    open "https://${repo}/compare/${branch}?expand=1"
}

# author:@me; [changes] if review:changes_requested or unresolved review threads
list_own_prs() {
    local repo url payload rows
    url=$(git config --get remote.origin.url) || return
    url="${url%.git}"
    case "$url" in
        git@*) repo="${url#*:}" ;;
        *) repo="${url#*://*/}" ;;
    esac
    payload=$(gh api graphql \
        -f q="repo:${repo} is:pr is:open author:@me sort:created-desc" \
        -f failing="repo:${repo} is:pr is:open author:@me status:failure" \
        -f query='
            query($q: String!, $failing: String!) {
              prs: search(query: $q, type: ISSUE, first: 30) {
                nodes {
                  ... on PullRequest {
                    number
                    title
                    isDraft
                    mergeable
                    additions
                    deletions
                    changedFiles
                    reviewDecision
                    reviewThreads(first: 100) {
                      nodes { isResolved }
                    }
                  }
                }
              }
              failing: search(query: $failing, type: ISSUE, first: 30) {
                nodes { ... on PullRequest { number } }
              }
            }
        ') || return

    rows=$(print -r -- "$payload" | jq -r '
            def rpad($n): tostring | (" " * ([($n - length), 0] | max)) + .;
            def lpad($n): tostring | . + (" " * ([($n - length), 0] | max));
            (.data.failing.nodes | map(.number // empty)) as $failing_ids
            | [
                .data.prs.nodes[]
                | select(.number)
                | {
                    id: "#\(.number)",
                    files: "\(.changedFiles)f",
                    diff: "+\(.additions)/-\(.deletions)",
                    badges: (
                        [
                            (if .number | IN($failing_ids[]) then "failing" else empty end),
                            (if .reviewDecision == "CHANGES_REQUESTED"
                                or any(.reviewThreads.nodes[]?; .isResolved | not)
                             then "changes" else empty end),
                            (if .mergeable == "CONFLICTING" then "conflicts" else empty end)
                        ] | join(" | ")
                        | if . == "" then "" else "[\(.)]" end
                    ),
                    title: (if .isDraft then "[DRAFT] \(.title)" else .title end)
                  }
              ] as $rows
            | ($rows | map(.id | length) | max // 0) as $nw
            | ($rows | map(.files | length) | max // 0) as $fw
            | ($rows | map(.badges | length) | max // 0) as $bw
            | $rows[]
            | [
                (.id | rpad($nw)),
                (.files | rpad($fw)),
                (.diff | lpad(12)),
                (if $bw > 0 then (.badges | lpad($bw)) else empty end),
                .title
              ] | join(" ")
        ') || return
    if [ -z "$rows" ]; then
        echo "no open PRs of yours"
        return 1
    fi
    print -r -- "$rows"
}

# $1: user-review-requested:@me | review-requested:@me
# draft:false status:success -review:changes_requested; skip mergeable==CONFLICTING
list_requested_prs() {
    local query="${1:-user-review-requested:@me}"
    local rows
    rows=$(gh pr list \
        --search "${query} draft:false status:success -review:changes_requested" \
        --json number,title,author,mergeable,changedFiles,additions,deletions \
        --jq '
            def rpad($n): tostring | (" " * ([($n - length), 0] | max)) + .;
            def lpad($n): tostring | . + (" " * ([($n - length), 0] | max)) | .[0:$n];
            [
                .[]
                | select(.mergeable != "CONFLICTING")
                | {
                    id: "#\(.number)",
                    files: "\(.changedFiles)f",
                    diff: "+\(.additions)/-\(.deletions)",
                    author: (.author.login // "?" | .[0:26]),
                    title
                  }
            ] as $rows
            | ($rows | map(.id | length) | max // 0) as $nw
            | ($rows | map(.files | length) | max // 0) as $fw
            | $rows[]
            | "\(.id | rpad($nw)) \(.files | rpad($fw)) \(.diff | lpad(12)) \(.author | lpad(26)) \(.title)"
        ') || return
    if [ -z "$rows" ]; then
        echo "no ready, green PRs requested of you"
        return 1
    fi
    print -r -- "$rows"
}

force_pull() {
    local branch=$(git branch --show-current)
    git fetch --all
    git reset --hard "origin/${branch}"
}

prune_fetch() {
    local main_branch="main"
    if git show-ref --verify --quiet refs/heads/main; then
        main_branch="main"
    elif git show-ref --verify --quiet refs/heads/master; then
        main_branch="master"
    else
        echo "error: no local 'main' or 'master' branch found."
        return 1
    fi

    # fetch and prune remote branches
    git fetch -p

    # get list of branches that are gone
    local gone_branches=$(git branch -vv | awk '/: gone]/ {print $1}')
    if [ -z "$gone_branches" ]; then
        return 0
    fi

    # delete merged branches
    for b in $gone_branches; do
        if git merge-base --is-ancestor "$b" "$main_branch"; then
            git branch -d "$b"
        fi
    done
}

netshoot() {
    local overrides='{"metadata":{"annotations":{"sidecar.istio.io/inject":"false"}}}'
    local ns="${1:-$(kubectl config view --minify --output 'jsonpath={..namespace}'; echo)}"

    kubectl run netshoot --rm -it \
        --image nicolaka/netshoot:latest \
        --namespace "${ns}" \
        --overrides "${overrides}" \
        -- "/bin/bash"
}
